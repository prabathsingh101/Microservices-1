{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "ConnectionStrings": {
    "CustomersDb_Prod": "Server=187.127.146.1;Database=CustomersDb;user id=sa;password=Anand@raj12345;TrustServerCertificate=True;Encrypt=False",
    "CustomersDb": "Server=sqlserver;Database=CustomersDb;user id=sa;password=Anand@raj12345;TrustServerCertificate=True;Encrypt=False",
    "LogsDb_Prod": "Server=187.127.146.1;Database=ErrorLogsDb;user id=sa;password=Anand@raj12345;TrustServerCertificate=True;Encrypt=False",
    "LogsDb": "Server=sqlserver;Database=ErrorLogsDb;user id=sa;password=Anand@raj12345;TrustServerCertificate=True;Encrypt=False"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "LogsDb",
          "sinkOptionsSection": {
            "tableName": "AppLogs"
          },
          "columnOptionsSection": {
            "additionalColumns": [
              {
                "ColumnName": "ServiceName",
                "DataType": "nvarchar",
                "DataLength": 50
              },
              {
                "ColumnName": "CorrelationId",
                "DataType": "nvarchar",
                "DataLength": 100
              }
            ]
          }
        }
      },
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "ServiceName": "Customers.API"
    }
  },
  "Jwt": {
    "Key": "ElectricApps2024SecretKeyForJWTTokenValidationHS256Algorithm",
    "Issuer": "ElectricApps.Identity",
    "Audience": "ElectricApps.API",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
