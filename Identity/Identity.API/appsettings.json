{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb_Prod": "Server=187.127.166.29;Database=IdentityDb;user id=sa;password=Anand@raj12345;TrustServerCertificate=True",
    "IdentityDb": "Server=sqlserver;Database=IdentityDb;user id=sa;password=Anand@raj12345;TrustServerCertificate=True",
    "LogsDb_Prod": "Server=187.127.166.29;Database=ErrorLogsDb;user id=sa;password=Anand@raj12345;TrustServerCertificate=True",
    "LogsDb": "Server=sqlserver;Database=ErrorLogsDb;user id=sa;password=Anand@raj12345;TrustServerCertificate=True"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "LogsDb",
          "sinkOptionsSection": {
            "tableName": "AppLogs",
            "autoCreateSqlTable": true,
            "autoCreateSqlDatabase": true
          },
          "columnOptionsSection": {
            "additionalColumns": [
              {
                "ColumnName": "ServiceName",
                "DataType": "nvarchar",
                "DataLength": 50
              },
              {
                "ColumnName": "CorrelationId",
                "DataType": "nvarchar",
                "DataLength": 100
              }
            ]
          }
        }
      },
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "ServiceName": "Identity.API"
    }
  },
  "Jwt": {
    "Key": "ElectricApps2024SecretKeyForJWTTokenValidationHS256Algorithm",
    "Issuer": "ElectricApps.Identity",
    "Audience": "ElectricApps.API",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Google": {
    "ClientId": "775097129947-q6q5apnitmllq80dj994b2l6hv0hbc39.apps.googleusercontent.com"
  },
  "ServiceUrls": {
    "CompanyApi": "http://company.api:8080"
  }
}
