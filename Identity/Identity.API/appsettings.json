{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": "Server=YOUR_SERVER;Database=IdentityDb;user id=YOUR_USER;password=YOUR_PASSWORD;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "YOUR_JWT_KEY_HERE",
    "Issuer": "Issuer",
    "Audience": "Audience",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  }

}
